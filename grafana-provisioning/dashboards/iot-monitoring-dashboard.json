      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT m.\"MeasurementDate\" AS \"time\", m.\"Temperature\" AS \"value\", s.\"Name\" AS metric FROM \"SensorMeasurements\" m JOIN \"Sensors\" s ON m.\"SensorId\" = s.\"Id\" WHERE $__timeFilter(m.\"MeasurementDate\") AND s.\"Name\" IN (${sensor:sqlstring}) ORDER BY m.\"MeasurementDate\" ASC;",
          "datasource": { "type": "postgres", "uid": "dfvg3buiwt3pcb" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",

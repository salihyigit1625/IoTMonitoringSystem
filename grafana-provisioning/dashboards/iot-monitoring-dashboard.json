        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS \"Uyarı\" FROM \"SensorMeasurements\" WHERE $__timeFilter(\"MeasurementDate\") AND (\"Temperature\" > 40 OR \"Humidity\" > 80 OR \"Pressure\" < 950);",

      "type": "timeseries",
      "title": "Sıcaklık Değişimi (°C)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "dfvg3buiwt3pcb" },
